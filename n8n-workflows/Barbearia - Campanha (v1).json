    {
      "parameters": {
        "amount": "={{ (() => {\n  const total = $('Buscar Destinatários Pendentes').all().length;\n  const blocoTamanho = total <= 20 ? 0 : total <= 100 ? 20 : total <= 300 ? 30 : 50;\n  const isLongBreak = blocoTamanho > 0 && $runIndex > 0 && $runIndex % blocoTamanho === (blocoTamanho - 1);\n  const base = isLongBreak ? Math.floor(Math.random() * 60) + 45 : Math.floor(Math.random() * 12) + 6;\n  const msgLen = ($('Formatar Mensagem WhatsApp').item.json.mensagem_formatada || '').length;\n  const typingBonus = Math.min(6, Math.round(msgLen / 40));\n  return base + typingBonus;\n})() }}"
      },
