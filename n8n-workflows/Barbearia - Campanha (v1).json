          "assignments": [
            {
              "id": "1a2b3c4d-5e6f-4789-9abc-def012345678",
              "name": "mensagem_formatada",
              "value": "={{ (() => {\n  // WhatsApp usa *negrito* (asterisco simples) e _itálico_, mas o admin digita\n  // no padrão Markdown (**negrito**, *itálico*). Converte antes de enviar,\n  // senão o cliente recebe os asteriscos literais no WhatsApp.\n  const raw = String($('Buscar Campanha').item.json.message || '');\n  const BOLD_MARK = '\\u0000';\n  let formatted = raw.replace(/\\*\\*(.+?)\\*\\*/g, (_, t) => BOLD_MARK + t + BOLD_MARK);\n  formatted = formatted.replace(/\\*(.+?)\\*/g, '_$1_');\n  formatted = formatted.split(BOLD_MARK).join('*');\n  return formatted;\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
